              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();\r",
                  "if(jsonData.code==200){\r",
                  "    var token = jsonData.token;\r",
                  "    pm.environment.set(\"my_token\",token);\r",
                  "    console.log(\"已成功设置token\");\r",
                  "}else{\r",
                  "    console.error(\"获取token失败\");\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"username\": \"gaoyuliang\",\r\n    \"password\": \"123456\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost/dev-api/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "path": [
                "dev-api",
                "login"
              ]
