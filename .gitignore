# ==========================
# 1. 编译输出、依赖及日志 (Java / Maven / Vue)
# ==========================
# Java 编译输出
**/target/
*.class
*.jar
*.war
*.ear

# Maven Wrapper (可选忽略)
.mvn/wrapper/maven-wrapper.jar

# Vue / Node 依赖及编译产物
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pnpm-lock.yaml

# 运行日志
logs/
*.log

# ==========================
# 2. IDE 配置文件 (IntelliJ IDEA / VSCode / Eclipse)
# ==========================
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
*.iws.bak


# VSCode
.vscode/

# ==========================
# 3. 系统临时文件
# ==========================
.DS_Store
Thumbs.db
*.swp
*.tmp
*.bak

# 忽略前端的环境配置与版本锁定文件
.env.staging
package-lock.json